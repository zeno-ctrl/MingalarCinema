# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/cinetown?schema=public"

# ---------------------------------------------------------------------------
# Auth.js / NextAuth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sign in with Apple. Requires a paid Apple Developer Program membership
# ($99/year). APPLE_ID is your Services ID (e.g. "mm.mingalarcinema.web").
# APPLE_SECRET is NOT a static value like Google's — it's a JWT you generate
# yourself from your Team ID, Key ID, and the .p8 private key Apple gives you
# when you create a "Sign in with Apple" key, and it expires after at most
# 6 months so it must be regenerated periodically. See:
# https://developer.apple.com/documentation/sign_in_with_apple/generate_and_validate_tokens
APPLE_ID=""
APPLE_SECRET=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
# Comma-separated list of emails allowed to be seeded/promoted as SUPER_ADMIN
SUPER_ADMIN_EMAIL="admin@cinetown.mm"
SUPER_ADMIN_PASSWORD="ChangeMe123!"
SUPER_ADMIN_NAME="Mingalar Cinema Super Admin"

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Mingalar Cinema <no-reply@cinetown.mm>"

# ---------------------------------------------------------------------------
# Object storage (Cloudinary)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Payments — Stripe (card, TEST mode)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Stripe doesn't support MMK; pick a currency your Stripe account supports.
STRIPE_CURRENCY="usd"

# ---------------------------------------------------------------------------
# Payments — KBZPay (sandbox/UAT)
# ---------------------------------------------------------------------------
KBZPAY_MERCHANT_ID=""
KBZPAY_APP_ID=""
KBZPAY_MERCHANT_KEY=""
KBZPAY_ENV="sandbox"
KBZPAY_BASE_URL="https://uat.kbzpay.com"
KBZPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Rate limiting (Upstash Redis - optional, falls back to in-memory in dev)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
