# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/cinetown?schema=public"

# ---------------------------------------------------------------------------
# Auth.js / NextAuth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
# Comma-separated list of emails allowed to be seeded/promoted as SUPER_ADMIN
SUPER_ADMIN_EMAIL="admin@cinetown.mm"
SUPER_ADMIN_PASSWORD="ChangeMe123!"
SUPER_ADMIN_NAME="CineTown Super Admin"

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="CineTown <no-reply@cinetown.mm>"

# ---------------------------------------------------------------------------
# Object storage (Cloudinary)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Payments — Stripe (card, TEST mode)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Stripe doesn't support MMK; pick a currency your Stripe account supports.
STRIPE_CURRENCY="usd"

# ---------------------------------------------------------------------------
# Payments — KBZPay (sandbox/UAT)
# ---------------------------------------------------------------------------
KBZPAY_MERCHANT_ID=""
KBZPAY_APP_ID=""
KBZPAY_MERCHANT_KEY=""
KBZPAY_ENV="sandbox"
KBZPAY_BASE_URL="https://uat.kbzpay.com"
KBZPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Rate limiting (Upstash Redis - optional, falls back to in-memory in dev)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
